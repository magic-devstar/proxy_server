{
  "server": {
    "logging": "info",
    "inflation": 0,
    "sni-check": false,
    "node-name": "rust-mvp-node",
    "update-interval": 10,
    "source-ips": [],
    "retries": {
      "max-retries": 3,
      "timeout": 5
    }
  },
  "api": [
    {
      "name": "local-control-plane",
      "base-url": "http://127.0.0.1:8000/api",
      "api-key": "your-api-key-here",
      "default-package": "residential",
      "legacy": false,
      "ports": {
        "userpass": "8080-8080",
        "ipauth": ""
      }
    }
  ],
  "upstream": [
    {
      "name": "provider-1",
      "ips": [
        "http://upstream1.example.com:10000",
        "http://upstream2.example.com:10000"
      ],
      "user": "upstream-username",
      "password": "upstream-password",
      "mapping": {
        "country": "country",
        "city": "city",
        "state": "state",
        "session": "session",
        "time": "time"
      },
      "separator": "-",
      "format-in": "username",
      "weight": 80,
      "package": "residential",
      "allowed-countries": []
    },
    {
      "name": "provider-2",
      "ips": [
        "socks5://upstream3.example.com:1080"
      ],
      "user": "socks-user",
      "password": "socks-pass",
      "mapping": {
        "country": "country",
        "session": "sessionid"
      },
      "separator": "_",
      "format-in": "username",
      "weight": 20,
      "package": "residential",
      "allowed-countries": ["us", "uk", "de"]
    }
  ],
  "clickhouse": {
    "host": "",
    "username": "",
    "password": ""
  }
}

